<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>【店員レジ】ラ・サール学園バザー POS</title>
  <link rel="stylesheet" href="https://fonts.googleapis.com/icon?family=Material+Icons">
  <style>
    :root {
      --primary: #1E3A8A;
      --success: #16A34A;
      --info: #0284C7;
      --danger: #D93025;
      --bg: #F1F5F9;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; font-family: sans-serif; }
    body { background: var(--bg); color: #1E293B; height: 100vh; overflow: hidden; }
    header { background: var(--primary); color: #FFF; padding: 12px 20px; display: flex; justify-content: space-between; align-items: center; }

    .workspace { display: flex; height: calc(100vh - 48px); }
    
    /* 左パネル: カメラ / テンキー */
    .left-panel { width: 320px; background: #0F172A; color: #FFF; padding: 16px; display: flex; flex-direction: column; gap: 16px; }
    .camera-box { width: 100%; aspect-ratio: 4/3; background: #1E293B; border-radius: 8px; overflow: hidden; position: relative; }
    #video-preview { width: 100%; height: 100%; object-fit: cover; }
    
    /* テンキーUI */
    .tenkey-display { display: flex; align-items: center; background: #1E293B; border: 1px solid #334155; border-radius: 6px; padding: 8px 12px; font-size: 18px; font-weight: 700; color: #38BDF8; }
    .tenkey-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
    .key-btn { background: #334155; color: #FFF; border: none; padding: 14px; border-radius: 6px; font-size: 18px; font-weight: 700; cursor: pointer; }
    .key-btn:active { background: #475569; }

    /* 中央パネル: 注文カード */
    .center-panel { flex: 1; padding: 20px; overflow-y: auto; }
    .order-card { background: #FFF; border-radius: 12px; padding: 24px; box-shadow: 0 2px 8px rgba(0,0,0,0.05); }
    .total-box { background: #FEF2F2; border: 1px solid #FCA5A5; border-radius: 8px; padding: 16px; display: flex; justify-content: space-between; align-items: center; margin-top: 20px; }

    /* 右パネル: ワンボタンステータス操作 */
    .right-panel { width: 280px; background: #FFF; border-left: 1px solid #E2E8F0; padding: 20px; display: flex; flex-direction: column; gap: 16px; }
    .btn-main { width: 100%; flex: 1; border: none; border-radius: 16px; color: #FFF; font-size: 22px; font-weight: 700; cursor: pointer; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px; }
    .btn-pay { background: var(--success); }
    .btn-deliver { background: var(--info); }
    .btn-main:disabled { background: #CBD5E1; cursor: not-allowed; }
    .btn-cancel { height: 80px; background: #EF4444; color: #FFF; border: none; border-radius: 12px; font-size: 16px; font-weight: 700; cursor: pointer; }
    .btn-cancel:disabled { background: #F1F5F9; color: #94A3B8; cursor: not-allowed; }
  </style>
</head>
<body>

  <header>
    <h2>POSレジ管理</h2>
    <div id="reg-id-display">レジ #1</div>
  </header>

  <div class="workspace">
    <!-- 左: カメラ & テンキー -->
    <div class="left-panel">
      <div class="camera-box">
        <video id="video-preview" autoplay playsinline muted></video>
      </div>
      <div>
        <label style="font-size: 11px; color: #94A3B8;">注文ID 電卓手入力</label>
        <div class="tenkey-display">
          <span>ORD</span>
          <span id="tenkey-val" style="margin-left: auto;">00000</span>
        </div>
      </div>
      <div class="tenkey-grid">
        <button class="key-btn" onclick="pressKey('7')">7</button>
        <button class="key-btn" onclick="pressKey('8')">8</button>
        <button class="key-btn" onclick="pressKey('9')">9</button>
        <button class="key-btn" onclick="pressKey('4')">4</button>
        <button class="key-btn" onclick="pressKey('5')">5</button>
        <button class="key-btn" onclick="pressKey('6')">6</button>
        <button class="key-btn" onclick="pressKey('1')">1</button>
        <button class="key-btn" onclick="pressKey('2')">2</button>
        <button class="key-btn" onclick="pressKey('3')">3</button>
        <button class="key-btn" style="background:#DC2626;" onclick="clearKey()">C</button>
        <button class="key-btn" onclick="pressKey('0')">0</button>
        <button class="key-btn" style="background:#0284C7;" onclick="submitTenKey()">検索</button>
      </div>
    </div>

    <!-- 中: 明細表示 -->
    <div class="center-panel">
      <div id="placeholder" style="text-align: center; color: #94A3B8; margin-top: 100px;">
        <span class="material-icons" style="font-size: 64px;">qr_code_scanner</span>
        <p>QRコードを読み取るか、テンキーで注文IDを入力してください。</p>
      </div>

      <div id="order-card" class="order-card" style="display: none;">
        <div style="display: flex; justify-content: space-between; border-bottom: 2px solid #F1F5F9; padding-bottom: 12px;">
          <div>
            <h3 id="card-email" style="color: var(--primary);">user@example.com</h3>
            <span id="card-status-badge" style="font-size: 12px; font-weight: 700; padding: 2px 8px; border-radius: 4px; background: #FEF3C7; color: #D97706;">未払い</span>
          </div>
          <div style="font-weight: 700;" id="card-order-id">ORD00001</div>
        </div>

        <div id="card-items" style="margin: 20px 0;"></div>

        <div class="total-box">
          <span style="font-weight: 700; color: #991B1B;">お会計 合計受領額</span>
          <span id="card-total" style="font-size: 28px; font-weight: 700; color: var(--danger);">¥0</span>
        </div>
      </div>
    </div>

    <!-- 右: 1つのメインボタン + 1つの中断ボタン -->
    <div class="right-panel">
      <button class="btn-main btn-pay" id="btn-main" onclick="handleMainAction()" disabled>
        <span class="material-icons" style="font-size: 48px;">check_circle</span>
        <span id="btn-main-text">🟢 支払い確定</span>
      </button>
      <button class="btn-cancel" id="btn-cancel" onclick="cancelTransaction()" disabled>🔴 注文中断</button>
    </div>
  </div>

  <script src="https://cdnjs.cloudflare.com/ajax/libs/jsQR/1.4.0/jsQR.min.js"></script>
  <script>
    const GAS_API_URL = "https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec";
    
    let rawDigits = "";
    let activeOrder = null;
    const regId = "レジ1";

    // テンキーロジック (1の位挿入・上位桁0埋め補正)
    function pressKey(num) {
      if (rawDigits.length >= 5) return;
      rawDigits += num;
      updateTenKeyDisplay();
    }
    function clearKey() {
      rawDigits = "";
      updateTenKeyDisplay();
    }
    function updateTenKeyDisplay() {
      const padded = rawDigits.padStart(5, "0");
      document.getElementById("tenkey-val").innerText = padded;
    }
    function submitTenKey() {
      const padded = rawDigits.padStart(5, "0");
      searchOrder(`ORD${padded}`, "");
    }

    // API 照会実行
    async function searchOrder(orderId, signature) {
      try {
        const res = await fetch(GAS_API_URL, {
          method: "POST",
          body: JSON.stringify({ action: "searchOrder", orderId, signature, regId })
        }).then(r => r.json());

        if (!res.success) throw new Error(res.message);

        activeOrder = res.order;
        renderOrderCard();
      } catch (err) {
        alert("照会エラー: " + err.message);
        resetUI();
      }
    }

    // カード描画 & ボタン状態設定
    function renderOrderCard() {
      document.getElementById("placeholder").style.display = "none";
      document.getElementById("order-card").style.display = "block";

      document.getElementById("card-email").innerText = activeOrder.email;
      document.getElementById("card-order-id").innerText = activeOrder.orderId;
      document.getElementById("card-total").innerText = `¥${activeOrder.totalAmount.toLocaleString()}`;

      const itemsDiv = document.getElementById("card-items");
      itemsDiv.innerHTML = "";
      for (const id in activeOrder.cart) {
        itemsDiv.innerHTML += `<div style="padding: 8px 0; border-bottom: 1px solid #F1F5F9;"><b>商品ID [${id}]</b> × ${activeOrder.cart[id]}個</div>`;
      }

      updateMainButton();
      document.getElementById("btn-cancel").disabled = false;
    }

    // ステータスに応じたメインボタンの自動変化
    function updateMainButton() {
      const mainBtn = document.getElementById("btn-main");
      const mainText = document.getElementById("btn-main-text");
      mainBtn.disabled = false;

      if (activeOrder.status === "未払い") {
        mainBtn.className = "btn-main btn-pay";
        mainText.innerText = "🟢 支払い確定";
      } else if (activeOrder.status === "支払い済") {
        mainBtn.className = "btn-main btn-deliver";
        mainText.innerText = "🔵 引換確定";
      } else {
        mainBtn.disabled = true;
      }
    }

    // メインボタン押下時の2段階確定処理
    async function handleMainAction() {
      document.getElementById("btn-main").disabled = true;

      try {
        if (activeOrder.status === "未払い") {
          const res = await fetch(GAS_API_URL, {
            method: "POST",
            body: JSON.stringify({ action: "confirmPayment", orderId: activeOrder.orderId, regId })
          }).then(r => r.json());

          if (!res.success) throw new Error(res.message);
          activeOrder.status = "支払い済";
          updateMainButton();
        } else if (activeOrder.status === "支払い済") {
          const res = await fetch(GAS_API_URL, {
            method: "POST",
            body: JSON.stringify({ action: "confirmDelivery", orderId: activeOrder.orderId, regId })
          }).then(r => r.json());

          if (!res.success) throw new Error(res.message);
          alert("✨ 引換完了しました。");
          resetUI();
        }
      } catch (err) {
        alert("処理エラー: " + err.message);
        document.getElementById("btn-main").disabled = false;
      }
    }

    async function cancelTransaction() {
      if (activeOrder) {
        await fetch(GAS_API_URL, {
          method: "POST",
          body: JSON.stringify({ action: "releaseLock", orderId: activeOrder.orderId, regId })
        });
      }
      resetUI();
    }

    function resetUI() {
      activeOrder = null;
      clearKey();
      document.getElementById("placeholder").style.display = "block";
      document.getElementById("order-card").style.display = "none";
      document.getElementById("btn-main").disabled = true;
      document.getElementById("btn-cancel").disabled = true;
    }
  </script>
</body>
</html>
